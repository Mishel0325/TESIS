.prendas-page {
  width: 100%;
  color: #14213d;
  font-family: Inter, "Segoe UI", Arial, sans-serif;
}

.prendas-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
  margin: 4px 0 18px;
}

.prendas-heading h2 {
  margin: 4px 0 5px;
  color: #12213a;
  font-size: 25px;
  line-height: 1.2;
  font-weight: 800;
}

.prendas-heading p {
  max-width: 760px;
  margin: 0;
  color: #718096;
  font-size: 12px;
  line-height: 1.55;
}

.prendas-eyebrow {
  color: #6f819c;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.prendas-primary,
.prendas-secondary,
.prendas-icon-button {
  font: inherit;
}

.prendas-primary {
  min-height: 38px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 0 16px;
  color: #ffffff;
  background: linear-gradient(135deg, #0871ca 0%, #0757a6 100%);
  border: 0;
  border-radius: 8px;
  cursor: pointer;
  font-size: 11px;
  font-weight: 800;
  white-space: nowrap;
  box-shadow: 0 8px 18px rgba(7, 87, 166, 0.18);
  transition: transform 0.18s ease, box-shadow 0.18s ease, opacity 0.18s ease;
}

.prendas-primary:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 12px 24px rgba(7, 87, 166, 0.24);
}

.prendas-primary:disabled,
.prendas-secondary:disabled,
.prendas-icon-button:disabled {
  cursor: not-allowed;
  opacity: 0.58;
}

.prendas-kpi-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  margin-bottom: 14px;
}

.prendas-kpi-grid-three {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.prendas-kpi-grid-four {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.prendas-kpi-card {
  min-height: 96px;
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 17px 18px;
  background: #ffffff;
  border: 1px solid #e4eaf2;
  border-radius: 11px;
  box-shadow: 0 4px 14px rgba(20, 33, 61, 0.06);
}

.prendas-kpi-icon {
  width: 48px;
  height: 48px;
  flex: 0 0 48px;
  display: grid;
  place-items: center;
  border-radius: 11px;
}

.prendas-kpi-icon.blue {
  color: #0871ca;
  background: #e7f2ff;
}

.prendas-kpi-icon.green {
  color: #239850;
  background: #e6f8ec;
}

.prendas-kpi-icon.purple {
  color: #7257bd;
  background: #f0ebff;
}

.prendas-kpi-icon.orange {
  color: #b36a10;
  background: #fff3df;
}

.prendas-kpi-card div {
  min-width: 0;
}

.prendas-kpi-card small,
.prendas-kpi-card span {
  display: block;
}

.prendas-kpi-card small {
  margin-bottom: 3px;
  color: #5f6f85;
  font-size: 10px;
  font-weight: 800;
}

.prendas-kpi-card strong {
  display: block;
  margin-bottom: 3px;
  color: #12213a;
  font-size: 24px;
  line-height: 1;
  font-weight: 850;
}

.prendas-kpi-card span:not(.prendas-kpi-icon) {
  color: #8895a7;
  font-size: 9px;
  font-weight: 600;
}

.prendas-alert {
  margin-bottom: 12px;
  padding: 10px 12px;
  border: 1px solid;
  border-radius: 8px;
  font-size: 10px;
  line-height: 1.45;
  font-weight: 700;
}

.prendas-alert.error {
  color: #a62c2c;
  background: #fff1f1;
  border-color: #f3caca;
}

.prendas-alert.success {
  color: #216f3d;
  background: #edf9f1;
  border-color: #ccebd6;
}

.prendas-workspace {
  overflow: hidden;
  background: #ffffff;
  border: 1px solid #e1e8f1;
  border-radius: 12px;
  box-shadow: 0 5px 18px rgba(20, 33, 61, 0.065);
}

.prendas-workspace-header {
  min-height: 70px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 16px 18px;
  background: #ffffff;
  border-bottom: 1px solid #e9eef5;
}

.prendas-workspace-header > div:first-child > span {
  display: block;
  margin-bottom: 4px;
  color: #7d8ca0;
  font-size: 8px;
  font-weight: 850;
  letter-spacing: 0.09em;
}

.prendas-workspace-header h3 {
  margin: 0;
  color: #17263f;
  font-size: 15px;
  font-weight: 800;
}

.prendas-toolbar {
  display: flex;
  align-items: center;
  gap: 8px;
}

.prendas-search {
  width: min(330px, 35vw);
  height: 36px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 11px;
  color: #77879c;
  background: #f8fafc;
  border: 1px solid #dde5ef;
  border-radius: 7px;
}

.prendas-search input {
  width: 100%;
  min-width: 0;
  padding: 0;
  color: #26364d;
  background: transparent;
  border: 0;
  outline: 0;
  font-size: 10px;
}

.prendas-search input::placeholder {
  color: #9ba7b7;
}

.prendas-icon-button {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  padding: 0;
  color: #0757a6;
  background: #eef5ff;
  border: 1px solid #d9e9fb;
  border-radius: 7px;
  cursor: pointer;
}

.prendas-icon-button.is-loading svg {
  animation: prendas-spin 0.8s linear infinite;
}

@keyframes prendas-spin {
  to {
    transform: rotate(360deg);
  }
}

.prendas-master-detail {
  min-height: 500px;
  display: grid;
  grid-template-columns: 350px minmax(0, 1fr);
}

.prendas-master-panel {
  min-width: 0;
  background: #f8fafc;
  border-right: 1px solid #e7edf5;
}

.prendas-panel-label {
  min-height: 47px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 15px;
  color: #65758b;
  border-bottom: 1px solid #e8edf4;
  font-size: 8px;
  font-weight: 850;
  letter-spacing: 0.08em;
}

.prendas-panel-label strong {
  min-width: 24px;
  height: 20px;
  display: grid;
  place-items: center;
  padding: 0 6px;
  color: #0757a6;
  background: #e5f0ff;
  border-radius: 999px;
  font-size: 9px;
  letter-spacing: 0;
}

.prendas-list {
  max-height: 590px;
  padding: 9px;
  overflow-y: auto;
}

.prendas-list-item {
  width: 100%;
  min-height: 74px;
  display: grid;
  grid-template-columns: 38px minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
  margin-bottom: 7px;
  padding: 10px 10px;
  color: #23344c;
  background: #ffffff;
  border: 1px solid #e5ebf3;
  border-radius: 9px;
  cursor: pointer;
  text-align: left;
  transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
}

.prendas-list-item:hover {
  border-color: #c8dced;
  box-shadow: 0 4px 12px rgba(20, 33, 61, 0.06);
  transform: translateY(-1px);
}

.prendas-list-item.is-active {
  background: #f5f9ff;
  border-color: #91bce1;
  box-shadow: inset 3px 0 0 #0757a6, 0 4px 14px rgba(7, 87, 166, 0.08);
}

.prendas-list-icon {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  color: #0871ca;
  background: #eaf3ff;
  border-radius: 8px;
}

.prendas-list-copy {
  min-width: 0;
}

.prendas-list-copy strong {
  display: block;
  margin-bottom: 4px;
  overflow: hidden;
  color: #1a2a43;
  font-size: 11px;
  font-weight: 800;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.prendas-list-copy small {
  display: -webkit-box;
  overflow: hidden;
  color: #7f8ca0;
  font-size: 8.5px;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.prendas-list-meta {
  display: flex;
  align-items: center;
  gap: 4px;
  color: #8190a4;
}

.prendas-list-meta > span {
  padding: 4px 7px;
  color: #5c6e86;
  background: #f0f4f8;
  border-radius: 999px;
  font-size: 8px;
  font-weight: 800;
  white-space: nowrap;
}

.prendas-list-item.is-active .prendas-list-meta > span {
  color: #0757a6;
  background: #e4f0ff;
}

.prendas-side-empty {
  padding: 52px 16px;
  color: #8794a6;
  font-size: 10px;
  font-weight: 700;
  text-align: center;
}

.prendas-detail-panel {
  min-width: 0;
  padding: 20px 22px 24px;
  background: #ffffff;
}

.prendas-detail-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18px;
  padding-bottom: 18px;
  border-bottom: 1px solid #edf1f6;
}

.prendas-detail-title {
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 12px;
}

.prendas-detail-icon {
  width: 43px;
  height: 43px;
  flex: 0 0 43px;
  display: grid;
  place-items: center;
  color: #0757a6;
  background: linear-gradient(145deg, #e7f2ff, #f4f8ff);
  border: 1px solid #d8e8f8;
  border-radius: 10px;
}

.prendas-detail-title > div > span {
  display: block;
  margin: 1px 0 4px;
  color: #8491a3;
  font-size: 8px;
  font-weight: 850;
  letter-spacing: 0.09em;
}

.prendas-detail-title h3 {
  margin: 0 0 4px;
  color: #15263f;
  font-size: 18px;
  font-weight: 850;
}

.prendas-detail-title p {
  max-width: 580px;
  margin: 0;
  color: #77869a;
  font-size: 9.5px;
  line-height: 1.5;
}

.prendas-detail-badges {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 6px;
}

.prendas-detail-badges span {
  padding: 5px 8px;
  color: #52647d;
  background: #f5f7fa;
  border: 1px solid #e6ebf1;
  border-radius: 999px;
  font-size: 8px;
  font-weight: 800;
  white-space: nowrap;
}

.prendas-flow-summary {
  min-height: 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin: 14px 0 6px;
  padding: 0 12px;
  color: #3a4d66;
  background: #f7f9fc;
  border: 1px solid #e8edf4;
  border-radius: 8px;
}

.prendas-flow-summary > span {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: #33506f;
  font-size: 9px;
  font-weight: 850;
}

.prendas-flow-summary > span svg {
  color: #0757a6;
}

.prendas-flow-summary small {
  color: #8491a3;
  font-size: 8.5px;
}

.prendas-flow-list {
  padding: 10px 2px 0;
}

.prendas-flow-step {
  display: grid;
  grid-template-columns: 42px minmax(0, 1fr);
  gap: 11px;
}

.prendas-flow-rail {
  position: relative;
  display: flex;
  justify-content: center;
}

.prendas-flow-number {
  position: relative;
  z-index: 2;
  width: 31px;
  height: 31px;
  display: grid;
  place-items: center;
  color: #ffffff;
  background: linear-gradient(145deg, #0b70c6, #0757a6);
  border: 4px solid #eaf3ff;
  border-radius: 50%;
  font-size: 9px;
  font-weight: 850;
  box-shadow: 0 2px 7px rgba(7, 87, 166, 0.15);
}

.prendas-flow-line {
  position: absolute;
  top: 29px;
  bottom: -16px;
  left: 50%;
  width: 2px;
  background: #dbe7f3;
  transform: translateX(-50%);
}

.prendas-flow-card {
  min-height: 58px;
  margin-bottom: 14px;
  overflow: hidden;
  background: #ffffff;
  border: 1px solid #e3eaf2;
  border-radius: 10px;
  box-shadow: 0 3px 10px rgba(20, 33, 61, 0.045);
}

.prendas-phase-header {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 12px 14px;
  background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
  border-bottom: 1px solid #edf1f6;
}

.prendas-phase-header > div:first-child {
  min-width: 0;
}

.prendas-phase-meta {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 6px;
}

.prendas-flow-kicker {
  display: block;
  margin-bottom: 3px;
  color: #8c99aa;
  font-size: 7.5px;
  font-weight: 850;
  letter-spacing: 0.07em;
}

.prendas-phase-header strong {
  display: block;
  overflow: hidden;
  color: #22344d;
  font-size: 10.5px;
  font-weight: 800;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.prendas-phase-id {
  flex: 0 0 auto;
  padding: 4px 7px;
  color: #6c7c91;
  background: #f4f6f9;
  border-radius: 999px;
  font-size: 7.5px;
  font-weight: 800;
}

.prendas-task-count {
  padding: 4px 7px;
  color: #0757a6;
  background: #eaf3ff;
  border-radius: 999px;
  font-size: 7.5px;
  font-weight: 850;
  white-space: nowrap;
}

.prendas-task-list {
  display: grid;
  gap: 1px;
  padding: 7px 10px 9px;
  background: #f8fafc;
}

.prendas-task-row {
  min-height: 48px;
  display: grid;
  grid-template-columns: 26px minmax(0, 1fr) auto;
  align-items: center;
  gap: 9px;
  padding: 7px 9px;
  background: #ffffff;
  border: 1px solid #edf1f5;
  border-radius: 7px;
}

.prendas-task-order {
  width: 24px;
  height: 24px;
  display: grid;
  place-items: center;
  color: #0757a6;
  background: #eaf3ff;
  border-radius: 6px;
  font-size: 8px;
  font-weight: 850;
}

.prendas-task-copy {
  min-width: 0;
}

.prendas-task-copy strong {
  display: block;
  margin-bottom: 2px;
  overflow: hidden;
  color: #26384f;
  font-size: 9.5px;
  font-weight: 750;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.prendas-task-copy small {
  color: #8b98a9;
  font-size: 7.5px;
}

.prendas-machine-badge {
  max-width: 145px;
  overflow: hidden;
  padding: 5px 8px;
  color: #5a4b17;
  background: #fff7dd;
  border: 1px solid #f3e6b6;
  border-radius: 999px;
  font-size: 7.5px;
  font-weight: 800;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.prendas-task-empty {
  padding: 12px;
  color: #8b98a9;
  background: #ffffff;
  border: 1px dashed #dce4ed;
  border-radius: 7px;
  font-size: 8.5px;
  text-align: center;
}

.prendas-no-phases,
.prendas-detail-empty {
  min-height: 310px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30px;
  color: #7b899d;
  text-align: center;
}

.prendas-no-phases-icon,
.prendas-detail-empty-icon {
  width: 58px;
  height: 58px;
  display: grid;
  place-items: center;
  margin-bottom: 12px;
  color: #7da8cf;
  background: #eef6ff;
  border-radius: 16px;
}

.prendas-no-phases h4,
.prendas-detail-empty h4 {
  margin: 0 0 6px;
  color: #40516a;
  font-size: 12px;
  font-weight: 800;
}

.prendas-no-phases p,
.prendas-detail-empty p {
  max-width: 430px;
  margin: 0;
  color: #8a97a8;
  font-size: 9px;
  line-height: 1.55;
}

.prendas-modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: grid;
  place-items: center;
  padding: 20px;
  background: rgba(10, 24, 43, 0.48);
  backdrop-filter: blur(2px);
}

.prendas-modal {
  width: min(540px, 100%);
  overflow: hidden;
  background: #ffffff;
  border: 1px solid #dce5f0;
  border-radius: 13px;
  box-shadow: 0 24px 70px rgba(7, 25, 48, 0.24);
}

.prendas-modal-header {
  min-height: 68px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 15px 18px;
  color: #ffffff;
  background: linear-gradient(105deg, #0a4e90 0%, #075aa3 58%, #06477f 100%);
}

.prendas-modal-header span {
  display: block;
  margin-bottom: 3px;
  color: #d7eaff;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.prendas-modal-header h3 {
  margin: 0;
  color: #ffffff;
  font-size: 16px;
  font-weight: 800;
}

.prendas-modal-header button {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  padding: 0;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 8px;
  cursor: pointer;
}

.prendas-form {
  display: grid;
  gap: 14px;
  padding: 20px;
}

.prendas-form-help {
  margin: 0;
  padding: 11px 12px;
  color: #53657d;
  background: #f5f8fc;
  border: 1px solid #e2eaf3;
  border-radius: 8px;
  font-size: 9.5px;
  line-height: 1.55;
}

.prendas-field {
  display: grid;
  gap: 6px;
}

.prendas-field > span {
  color: #32445d;
  font-size: 10px;
  font-weight: 800;
}

.prendas-field input,
.prendas-field textarea {
  width: 100%;
  padding: 10px 11px;
  color: #22334b;
  background: #ffffff;
  border: 1px solid #d8e2ed;
  border-radius: 8px;
  outline: none;
  font: inherit;
  font-size: 11px;
  transition: border-color 0.18s ease, box-shadow 0.18s ease;
}

.prendas-field textarea {
  min-height: 92px;
  resize: vertical;
}

.prendas-field input:focus,
.prendas-field textarea:focus {
  border-color: #5d9fda;
  box-shadow: 0 0 0 3px rgba(7, 87, 166, 0.09);
}

.prendas-field small {
  color: #8794a6;
  font-size: 8.5px;
}

.prendas-modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 9px;
  padding-top: 4px;
}

.prendas-secondary {
  min-height: 38px;
  padding: 0 16px;
  color: #526177;
  background: #ffffff;
  border: 1px solid #d8e1eb;
  border-radius: 8px;
  cursor: pointer;
  font-size: 10px;
  font-weight: 800;
}

@media (max-width: 980px) {
  .prendas-kpi-grid-three {
    grid-template-columns: 1fr 1fr;
  }

  .prendas-master-detail {
    grid-template-columns: 300px minmax(0, 1fr);
  }
}

@media (max-width: 760px) {
  .prendas-heading,
  .prendas-workspace-header,
  .prendas-detail-header {
    flex-direction: column;
    align-items: stretch;
  }

  .prendas-heading .prendas-primary {
    align-self: flex-start;
  }

  .prendas-kpi-grid,
  .prendas-kpi-grid-three {
    grid-template-columns: 1fr;
  }

  .prendas-toolbar {
    width: 100%;
  }

  .prendas-search {
    width: 100%;
  }

  .prendas-master-detail {
    grid-template-columns: 1fr;
  }

  .prendas-master-panel {
    border-right: 0;
    border-bottom: 1px solid #e7edf5;
  }

  .prendas-list {
    max-height: 330px;
  }

  .prendas-detail-panel {
    padding: 18px 14px 22px;
  }

  .prendas-detail-badges {
    justify-content: flex-start;
  }

  .prendas-flow-summary {
    align-items: flex-start;
    flex-direction: column;
    padding: 10px 12px;
  }
}


#seccion-fases-tareas {
  scroll-margin-top: 78px;
}

@media (max-width: 1180px) {
  .prendas-kpi-grid-four {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 760px) {
  .prendas-kpi-grid-four {
    grid-template-columns: 1fr;
  }

  .prendas-task-row {
    grid-template-columns: 26px minmax(0, 1fr);
  }

  .prendas-machine-badge {
    grid-column: 2;
    justify-self: start;
    max-width: 100%;
  }

  .prendas-phase-header {
    align-items: flex-start;
    flex-direction: column;
  }
}

/* ===== CRUD FASES Y TAREAS ===== */
#seccion-fases-tareas {
  scroll-margin-top: 78px;
}

.prendas-detail-side {
  flex: 0 0 auto;
  display: grid;
  justify-items: end;
  gap: 9px;
}

.prendas-small-primary {
  min-height: 32px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 0 11px;
  color: #ffffff;
  background: #0757a6;
  border: 0;
  border-radius: 7px;
  cursor: pointer;
  font-size: 8.5px;
  font-weight: 850;
  box-shadow: 0 4px 10px rgba(7, 87, 166, 0.15);
}

.prendas-empty-action {
  margin-top: 16px;
}

.prendas-phase-right {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 10px;
}

.prendas-phase-actions,
.prendas-task-actions {
  display: flex;
  align-items: center;
  gap: 5px;
}

.prendas-action-button {
  min-width: 28px;
  height: 28px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 0 7px;
  color: #52657d;
  background: #ffffff;
  border: 1px solid #dce5ef;
  border-radius: 6px;
  cursor: pointer;
  font-size: 7.5px;
  font-weight: 850;
  transition: background 0.16s ease, border-color 0.16s ease, color 0.16s ease;
}

.prendas-action-button:hover {
  color: #0757a6;
  background: #f2f7fd;
  border-color: #bfd8ef;
}

.prendas-action-button.add {
  color: #0757a6;
  background: #eef6ff;
  border-color: #d7e9fb;
}

.prendas-action-button.danger {
  color: #a92d2d;
  background: #fff7f7;
  border-color: #f0d6d6;
}

.prendas-action-button.danger:hover {
  color: #8f1f1f;
  background: #fff0f0;
  border-color: #e9bdbd;
}

.prendas-task-row {
  grid-template-columns: 26px minmax(0, 1fr) minmax(90px, auto) auto;
}

.prendas-task-empty {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  text-align: left;
}

.prendas-task-empty button {
  min-height: 28px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 0 9px;
  color: #0757a6;
  background: #eef6ff;
  border: 1px solid #d6e8fa;
  border-radius: 6px;
  cursor: pointer;
  font-size: 8px;
  font-weight: 850;
  white-space: nowrap;
}

.prendas-form-grid-two {
  display: grid;
  grid-template-columns: minmax(0, 1.4fr) minmax(120px, 0.6fr);
  gap: 12px;
}

.prendas-modal-header.danger {
  background: linear-gradient(105deg, #8f2626 0%, #b43a3a 58%, #7d2020 100%);
}

.prendas-delete-confirm {
  padding: 7px 4px 2px;
  text-align: center;
}

.prendas-delete-icon {
  width: 54px;
  height: 54px;
  display: grid;
  place-items: center;
  margin: 0 auto 12px;
  color: #b33131;
  background: #fff0f0;
  border: 1px solid #f1caca;
  border-radius: 14px;
}

.prendas-delete-confirm h4 {
  margin: 0 0 7px;
  color: #28394f;
  font-size: 14px;
  font-weight: 850;
}

.prendas-delete-confirm p {
  max-width: 430px;
  margin: 0 auto;
  color: #758399;
  font-size: 9.5px;
  line-height: 1.6;
}

.prendas-danger-button {
  min-height: 38px;
  padding: 0 16px;
  color: #ffffff;
  background: #b33131;
  border: 0;
  border-radius: 8px;
  cursor: pointer;
  font-size: 10px;
  font-weight: 850;
}

.prendas-danger-button:disabled {
  cursor: not-allowed;
  opacity: 0.58;
}

@media (max-width: 900px) {
  .prendas-phase-header,
  .prendas-phase-right {
    align-items: flex-start;
  }

  .prendas-phase-right {
    flex-direction: column;
  }
}

@media (max-width: 760px) {
  .prendas-detail-side {
    width: 100%;
    justify-items: start;
  }

  .prendas-detail-badges {
    justify-content: flex-start;
  }

  .prendas-phase-header,
  .prendas-phase-right {
    flex-direction: column;
    align-items: stretch;
  }

  .prendas-phase-actions {
    justify-content: flex-end;
  }

  .prendas-task-row {
    grid-template-columns: 26px minmax(0, 1fr) auto;
  }

  .prendas-machine-badge {
    grid-column: 2 / 3;
    justify-self: start;
  }

  .prendas-task-actions {
    grid-column: 3 / 4;
    grid-row: 1 / 3;
  }

  .prendas-form-grid-two {
    grid-template-columns: 1fr;
  }
}

/* Acciones de creación encadenada: permiten fases y tareas sin límite. */
.prendas-modal-actions-wrap {
  flex-wrap: wrap;
}

.prendas-secondary-accent {
  color: #0757a6;
  background: #eef5ff;
  border-color: #cfe1f6;
}

.prendas-secondary-accent:hover:not(:disabled) {
  background: #e3f0ff;
  border-color: #b7d4f1;
}

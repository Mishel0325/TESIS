    setError("");
    try {
      await eliminarArchivoDisponible(archivo.id);
      setMensaje("Archivo eliminado correctamente.");
      await cargarInformacion(false);
    } catch (err) {
      setError(obtenerMensajeError(err, "No se pudo eliminar el archivo."));
    } finally {

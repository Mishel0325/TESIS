  const guardarSeguimiento = async (event) => {
    event.preventDefault();
    if (!pedidoSeguimiento || !esSupervisor) return;

    const idFase = Number(formularioSeguimiento.id_fase);
    const avance = Number(formularioSeguimiento.porcentaje_avance);
    const inicio = fechaHoraAISO(formularioSeguimiento.fecha_inicio);
    const fin = fechaHoraAISO(formularioSeguimiento.fecha_fin);
    const observacion = formularioSeguimiento.observacion.trim();

    if (!Number.isInteger(idFase) || idFase <= 0) {
      setErrorSeguimiento("Debe seleccionar una fase de producción.");
      return;
    }
    if (Number.isNaN(avance) || avance < 0 || avance > 100) {
      setErrorSeguimiento("El porcentaje de avance debe estar entre 0 y 100.");
      return;
    }
    if (!inicio || !fin) {
      setErrorSeguimiento("La fecha de inicio y la fecha de fin son obligatorias.");
      return;

    if (!observacion) {
      setErrorSeguimiento("La observación es obligatoria.");
      return;
    }

    const payload = {
      id_pedido: Number(pedidoSeguimiento.id),
      id_fase: idFase,
      porcentaje_avance: avance,
      fecha_inicio: inicio,
      fecha_fin: fin,
      estado: formularioSeguimiento.estado,
      observacion,
    };

    setGuardandoSeguimiento(true);
    setErrorSeguimiento("");
    setError("");

    try {
      await crearSeguimientoDisponible(payload);
      setMensaje(`Seguimiento de ${pedidoSeguimiento.codigo} registrado correctamente.`);
      setModalSeguimientoAbierto(false);
      setPedidoSeguimiento(null);
